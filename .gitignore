# 运行期产物（打包时随附的浏览器 / WebView2 运行时）
runtime/
__pycache__/
*.pyc

# 依赖 / 虚拟环境
.venv/
venv/
env/
*.egg-info/

# 构建产物（PyInstaller --onedir）
dist/
build/

# 用户数据 / 已录制的导出文件
*.har
*.json
# SQLite 持久化库（录制数据的唯一真源，随本机生成，不入库）
data/
!requirements.txt

# 日志（运行时重定向输出）
*.log

# 测试 / 类型检查缓存
.pytest_cache/
.mypy_cache/

# 编辑器 / 系统冗余文件
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
Desktop.ini

# WorkBuddy 工作区记忆 / 内部数据（非项目代码，不同机器/会话差异大）
.workbuddy/
